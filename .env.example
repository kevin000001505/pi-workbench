# Copy to .env and fill in.

# Encrypts the secrets you add in the UI. Generate once: openssl rand -base64 32
# Keep a copy somewhere safe: if it is lost, saved secrets cannot be decrypted (re-enter them).
WORKBENCH_MASTER_KEY=

# There is no login, so publish the UI only on an address you trust: your VM's LAN or Tailscale IP.
BIND_ADDR=127.0.0.1
PORT=8787

# Hostnames (not IPs) you open the UI by, comma-separated, e.g. workbench.lan,myvm.tail1234.ts.net.
# IP addresses and localhost always work; other names are refused to block DNS-rebinding attacks.
ALLOWED_HOSTS=

# Model defaults for the first boot; change them later on the Settings page.
# llm-model-manager publishes llama-swap on the host's port 8080.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=Qwen3.8-27B-radiance
LLM_CONTEXT_WINDOW=262144
LLM_MAX_TOKENS=32768
